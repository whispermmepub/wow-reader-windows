<Window x:Class="WowReader.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="WoW Reader for Windows" Icon="/WowReader.Windows;component/Assets/wow-reader-icon.png" Width="1240" Height="860" MinWidth="1000" MinHeight="640"
        Background="#F4F5F3" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="#D9DEDA" BorderThickness="0,0,0,1" Padding="20,12">
      <DockPanel LastChildFill="True">
        <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="Import book…" Click="OpenButton_Click"
                Background="#275D50" Foreground="White" FontWeight="SemiBold" Margin="12,0,0,0" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/WowReader.Windows;component/Assets/wow-logo.png" Width="34" Height="34" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="WoW Reader" FontSize="21" FontWeight="Bold" Foreground="#20342D" VerticalAlignment="Center" Margin="0,0,22,0" />
          <Button x:Name="HomeNavButton" Content="Home" Tag="Home" Click="NavButton_Click" />
          <Button x:Name="LibraryNavButton" Content="Library" Tag="Library" Click="NavButton_Click" />
          <Button x:Name="ExploreNavButton" Content="Explore" Tag="Explore" Click="NavButton_Click" />
          <Button x:Name="ReaderNavButton" Content="Reader" Tag="Reader" Click="NavButton_Click" />
          <Button x:Name="StatisticsNavButton" Content="Statistics" Tag="Statistics" Click="NavButton_Click" />
          <Button x:Name="CalendarNavButton" Content="Calendar" Tag="Calendar" Click="NavButton_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" x:Name="ViewHost">
      <ScrollViewer x:Name="HomeView" Visibility="Visible" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Margin="28,30,28,40">
          <TextBlock Text="Your reading home" FontSize="30" FontWeight="SemiBold" Foreground="#20342D" />
          <TextBlock Text="A quiet place for your books and reading progress on this PC." FontSize="14" Foreground="#65726B" Margin="0,7,0,22" />
          <Border Background="#275D50" CornerRadius="14" Padding="26" Margin="0,0,0,18">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PICK UP WHERE YOU LEFT OFF" FontSize="11" FontWeight="Bold" Foreground="#C8E0D6" />
                <TextBlock x:Name="HomeLastTitleText" Text="Your next chapter starts here" FontSize="25" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,2" TextWrapping="Wrap" />
                <TextBlock x:Name="HomeLastMetaText" Text="Import an EPUB to begin your local library." FontSize="14" Foreground="#E3EEE9" TextWrapping="Wrap" />
              </StackPanel>
              <Button x:Name="HomeContinueButton" Grid.Column="1" Content="Continue reading" Tag="" Click="HomeContinueButton_Click"
                      VerticalAlignment="Center" Margin="20,0,0,0" Background="White" Foreground="#275D50" FontWeight="SemiBold" IsEnabled="False" />
            </Grid>
          </Border>
          <UniformGrid Columns="3" Margin="0,0,0,20">
            <Border Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,12,0">
              <StackPanel><TextBlock Text="IN YOUR LIBRARY" FontSize="11" FontWeight="Bold" Foreground="#65726B"/><TextBlock x:Name="HomeLibraryCountText" Text="0 books" FontSize="25" FontWeight="SemiBold" Foreground="#20342D" Margin="0,6,0,0"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,12,0">
              <StackPanel><TextBlock Text="READ TODAY" FontSize="11" FontWeight="Bold" Foreground="#65726B"/><TextBlock x:Name="HomeReadTodayText" Text="0 min" FontSize="25" FontWeight="SemiBold" Foreground="#20342D" Margin="0,6,0,0"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="18">
              <StackPanel><TextBlock Text="READING DAYS" FontSize="11" FontWeight="Bold" Foreground="#65726B"/><TextBlock x:Name="HomeActiveDaysText" Text="0 days" FontSize="25" FontWeight="SemiBold" Foreground="#20342D" Margin="0,6,0,0"/></StackPanel>
            </Border>
          </UniformGrid>
          <TextBlock Text="Your reading tools" FontSize="20" FontWeight="SemiBold" Foreground="#20342D" Margin="0,0,0,10" />
          <UniformGrid Columns="4">
            <Button Content="Browse your books  ›" Tag="Library" Click="NavButton_Click" HorizontalContentAlignment="Left" Padding="18" Margin="0,0,12,0" />
            <Button Content="See reading statistics  ›" Tag="Statistics" Click="NavButton_Click" HorizontalContentAlignment="Left" Padding="18" Margin="0,0,12,0" />
            <Button Content="Open reading calendar  ›" Tag="Calendar" Click="NavButton_Click" HorizontalContentAlignment="Left" Padding="18" Margin="0,0,12,0" />
            <Button Content="Explore public posts  ›" Tag="Explore" Click="NavButton_Click" HorizontalContentAlignment="Left" Padding="18" Margin="0,0,12,0" />
            <Button Content="Notes &amp; highlights  ›" Click="NotesHubButton_Click" HorizontalContentAlignment="Left" Padding="18" />
          </UniformGrid>
          <Border Background="#E9EFEB" CornerRadius="8" Padding="14" Margin="0,22,0,0">
            <TextBlock Text="Private by design: books, reading positions, and new reading activity stay in local files under %LOCALAPPDATA%\\WoWReader. Nothing is uploaded." Foreground="#44564E" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="ExploreView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Margin="28,30,28,40">
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Refresh public posts" Click="RefreshExploreButton_Click" Background="#275D50" Foreground="White" FontWeight="SemiBold" />
            <TextBlock Text="Explore" FontSize="30" FontWeight="SemiBold" Foreground="#20342D" />
          </DockPanel>
          <TextBlock Text="Public posts from the three blogs used by the Android Explore feed. Feed requests happen only when you open or refresh this screen; no book, search, or reading data is sent." FontSize="14" Foreground="#65726B" Margin="0,0,0,6" TextWrapping="Wrap" />
          <TextBlock x:Name="ExploreStatusText" Text="Open Explore to load recent public posts." FontSize="12" Foreground="#78847E" Margin="0,0,0,14" TextWrapping="Wrap" />
          <ItemsControl x:Name="ExplorePostItems">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Tag="{Binding Url}" Click="OpenExplorePostButton_Click" HorizontalContentAlignment="Stretch" Padding="16" Margin="0,0,0,10" Background="White" BorderBrush="#E0E4E0" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="#20342D" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Source}" FontSize="12" Foreground="#275D50" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Excerpt}" FontSize="13" Foreground="#65726B" Margin="0,6,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="LibraryView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Margin="28,30,28,40">
          <DockPanel Margin="0,0,0,16">
            <TextBlock Text="Your library" FontSize="30" FontWeight="SemiBold" Foreground="#20342D" />
            <Button DockPanel.Dock="Right" Content="Import book…" Click="OpenButton_Click" Background="#275D50" Foreground="White" FontWeight="SemiBold" />
          </DockPanel>
          <TextBlock Text="EPUBs and PDFs stored on this PC. Add local shelves and metadata with Details; no book files are uploaded." FontSize="14" Foreground="#65726B" Margin="0,0,0,18" TextWrapping="Wrap" />
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
            <TextBox x:Name="LibrarySearchBox" Grid.Column="0" ToolTip="Search titles in this local library" TextChanged="LibrarySearchBox_TextChanged" Padding="10,7" Margin="0,0,8,0" />
            <ComboBox x:Name="LibrarySortPicker" Grid.Column="1" SelectedValuePath="Tag" SelectedIndex="0" SelectionChanged="LibrarySortPicker_SelectionChanged" VerticalContentAlignment="Center">
              <ComboBoxItem Content="Recently added" Tag="recent"/><ComboBoxItem Content="Title A–Z" Tag="title"/><ComboBoxItem Content="Title Z–A" Tag="title-desc"/><ComboBoxItem Content="Author A–Z" Tag="author"/><ComboBoxItem Content="Highest rated" Tag="rating"/>
            </ComboBox>
            <ComboBox x:Name="LibraryStatusPicker" Grid.Column="2" SelectedValuePath="Tag" SelectedIndex="0" SelectionChanged="LibraryStatusPicker_SelectionChanged" VerticalContentAlignment="Center" Margin="8,0,0,0">
              <ComboBoxItem Content="All books" Tag="all"/><ComboBoxItem Content="Reading" Tag="reading"/><ComboBoxItem Content="Unread" Tag="unread"/><ComboBoxItem Content="Finished" Tag="finished"/>
            </ComboBox>
          </Grid>
          <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Shelf" VerticalAlignment="Center" Foreground="#52645B" Margin="0,0,8,0" />
            <ComboBox x:Name="LibraryShelfPicker" Width="230" SelectedIndex="0" SelectionChanged="LibraryShelfPicker_SelectionChanged" VerticalContentAlignment="Center" />
            <TextBlock Text="Create and edit shelf names from a book’s Details window." VerticalAlignment="Center" Foreground="#78847E" Margin="10,0,0,0" />
          </DockPanel>
          <TextBlock x:Name="LibraryResultCountText" Text="0 books" FontSize="12" Foreground="#78847E" Margin="0,0,0,10" />
          <Border x:Name="LibraryEmptyState" Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="28" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center"><TextBlock Text="Nothing here yet" FontSize="20" FontWeight="SemiBold" Foreground="#20342D" TextAlignment="Center"/><TextBlock x:Name="LibraryEmptyText" Text="Import an EPUB from your PC to add it to this local library." Foreground="#65726B" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
          </Border>
          <ItemsControl x:Name="LibraryBookItems" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="14" Margin="0,0,0,10" Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="8">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding CoverPath}" Width="54" Height="72" Stretch="UniformToFill" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Tag="{Binding Id}" Click="LibraryBookButton_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="2">
                      <StackPanel><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="#20342D" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" FontSize="13" Foreground="#65726B" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Grid.Column="2" Tag="{Binding Id}" Click="LibraryBookDetailsButton_Click" Content="Details…" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="Open  ›" Foreground="#275D50" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,2,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="StatisticsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Margin="28,30,28,40">
          <DockPanel Margin="0,0,0,0">
            <Button DockPanel.Dock="Right" Content="Save reading recap…" Click="ReadingRecapButton_Click" Background="#275D50" Foreground="White" FontWeight="SemiBold" />
            <TextBlock Text="Reading statistics" FontSize="30" FontWeight="SemiBold" Foreground="#20342D" />
          </DockPanel>
          <TextBlock Text="Reading time is estimated from the time a book is open while this app window is active. New Windows activity starts being recorded now; Android history is not imported or synced." FontSize="14" Foreground="#65726B" Margin="0,7,0,22" TextWrapping="Wrap" />
          <UniformGrid Columns="6" Margin="0,0,0,24">
            <Border Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="TOTAL READING" FontSize="11" FontWeight="Bold" Foreground="#65726B"/><TextBlock x:Name="StatsTotalText" Text="0 min" FontSize="23" FontWeight="SemiBold" Foreground="#20342D" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="TODAY" FontSize="11" FontWeight="Bold" Foreground="#65726B"/><TextBlock x:Name="StatsTodayText" Text="0 min" FontSize="23" FontWeight="SemiBold" Foreground="#20342D" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="ACTIVE DAYS" FontSize="11" FontWeight="Bold" Foreground="#65726B"/><TextBlock x:Name="StatsActiveDaysText" Text="0" FontSize="23" FontWeight="SemiBold" Foreground="#20342D" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="CURRENT STREAK" FontSize="11" FontWeight="Bold" Foreground="#65726B"/><TextBlock x:Name="StatsStreakText" Text="0 days" FontSize="23" FontWeight="SemiBold" Foreground="#20342D" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="10,0,0,0"><StackPanel><TextBlock Text="LONGEST STREAK" FontSize="11" FontWeight="Bold" Foreground="#65726B"/><TextBlock x:Name="StatsLongestStreakText" Text="0 days" FontSize="23" FontWeight="SemiBold" Foreground="#20342D" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="10,0,0,0"><StackPanel><TextBlock Text="FINISHED BOOKS" FontSize="11" FontWeight="Bold" Foreground="#65726B"/><TextBlock x:Name="StatsFinishedBooksText" Text="0" FontSize="23" FontWeight="SemiBold" Foreground="#20342D" Margin="0,6,0,0"/></StackPanel></Border>
          </UniformGrid>
          <Border Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="22">
            <StackPanel><TextBlock Text="This week" FontSize="20" FontWeight="SemiBold" Foreground="#20342D"/><TextBlock x:Name="StatsWeekTotalText" Text="0 minutes read this week" Foreground="#65726B" Margin="0,4,0,12"/>
              <ItemsControl x:Name="StatsWeekBars">
                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DayLabel}" Foreground="#52645B" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent}" Height="12" VerticalAlignment="Center" Foreground="#4B8A73" Background="#E9EFEB"/><TextBlock Grid.Column="2" Text="{Binding MinutesText}" Foreground="#52645B" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,14,0,0">
            <StackPanel><TextBlock Text="Most read books" FontSize="20" FontWeight="SemiBold" Foreground="#20342D"/><TextBlock Text="Time tracked in this Windows app only." Foreground="#65726B" Margin="0,4,0,10"/><ItemsControl x:Name="StatsTopBooks"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,5"><TextBlock Text="{Binding Title}" Foreground="#34453C"/><TextBlock Text="{Binding TimeText}" DockPanel.Dock="Right" Foreground="#52645B"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
          </Border>
          <TextBlock x:Name="StatsSessionCountText" Text="Sessions are grouped when reading activity is separated by a 15-minute pause." FontSize="12" Foreground="#78847E" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>

      <Grid x:Name="CalendarView" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="28,26,28,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <ComboBox x:Name="CalendarPeriodPicker" Width="120" SelectedIndex="0" SelectionChanged="CalendarPeriodPicker_SelectionChanged" VerticalContentAlignment="Center" Margin="0,0,6,0"><ComboBoxItem Content="Month" Tag="month"/><ComboBoxItem Content="Week" Tag="week"/><ComboBoxItem Content="Year" Tag="year"/></ComboBox>
            <Button Content="‹ Previous" Click="PreviousMonthButton_Click"/><Button Content="Next ›" Click="NextMonthButton_Click" Margin="6,0,0,0"/>
          </StackPanel>
          <StackPanel><TextBlock Text="Reading calendar" FontSize="29" FontWeight="SemiBold" Foreground="#20342D"/><TextBlock Text="A local view of the days you read on this PC." FontSize="14" Foreground="#65726B" Margin="0,5,0,0"/></StackPanel>
        </DockPanel>
        <TextBlock x:Name="CalendarMonthText" Grid.Row="1" Text="October 2026" FontSize="19" FontWeight="SemiBold" Foreground="#20342D" HorizontalAlignment="Center" Margin="0,10,0,10" />
        <Border x:Name="CalendarMonthWeekBorder" Grid.Row="2" Margin="28,0,28,14" Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="10" Padding="14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <UniformGrid x:Name="CalendarWeekdayHeaders" Columns="7" Grid.Row="0"><TextBlock Text="MON"/><TextBlock Text="TUE"/><TextBlock Text="WED"/><TextBlock Text="THU"/><TextBlock Text="FRI"/><TextBlock Text="SAT"/><TextBlock Text="SUN"/></UniformGrid>
            <ItemsControl x:Name="CalendarDays" Grid.Row="1">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><primitives:UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Tag="{Binding Date}" Click="CalendarDay_Click" Background="{Binding Background}" Foreground="{Binding Foreground}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" Padding="4" Margin="3" ToolTip="{Binding ToolTipText}" IsEnabled="{Binding IsCurrentMonth}">
                    <StackPanel><TextBlock Text="{Binding DayNumber}" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding MinutesText}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
        <ItemsControl x:Name="CalendarYearMonths" Grid.Row="2" Margin="28,0,28,14" Visibility="Collapsed">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><primitives:UniformGrid Columns="3" Rows="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Tag="{Binding Date}" Click="CalendarYearMonth_Click" Margin="5" Padding="14" Background="White" BorderBrush="#E0E4E0" BorderThickness="1">
              <StackPanel><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="#20342D" HorizontalAlignment="Center"/><TextBlock Text="{Binding Summary}" FontSize="13" Foreground="#65726B" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Row="3" Margin="28,0,28,20" Background="#E9EFEB" CornerRadius="8" Padding="14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0"><TextBlock x:Name="CalendarSelectedDateText" Text="Select a day" FontWeight="SemiBold" Foreground="#20342D"/><TextBlock x:Name="CalendarSelectedActivityText" DockPanel.Dock="Right" Text="No reading recorded" Foreground="#52645B"/></DockPanel>
            <TextBlock x:Name="CalendarBookNamesText" Grid.Row="1" Margin="0,6,0,8" Foreground="#65726B" TextTrimming="CharacterEllipsis"/>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CalendarDayNoteBox" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxHeight="72" VerticalScrollBarVisibility="Auto" ToolTip="Add a private note for this reading day"/><Button Grid.Column="1" Content="Save day note" Click="SaveCalendarDayNoteButton_Click" Margin="10,0,0,0" VerticalAlignment="Center"/></Grid>
            <DockPanel Grid.Row="3" Margin="0,10,0,4"><TextBlock Text="Book for memory" Foreground="#52645B" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="CalendarMemoryBookPicker" Width="260" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="CalendarMemoryBookPicker_SelectionChanged" VerticalContentAlignment="Center"/><Button x:Name="CalendarMemorySaveButton" Content="Save book memory" Click="SaveCalendarDayMemoryButton_Click" Margin="10,0,0,0" /></DockPanel>
            <TextBox x:Name="CalendarMemoryTextBox" Grid.Row="4" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" MaxHeight="70" VerticalScrollBarVisibility="Auto" ToolTip="A private memory about this book on this date" />
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="ReaderView" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#D9DEDA" BorderThickness="0,0,0,1" Padding="16,9">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True">
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="LibraryPicker" Width="240" Margin="0,0,12,0" VerticalContentAlignment="Center" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="LibraryPicker_SelectionChanged" ToolTip="Books stored on this device" />
                <Button x:Name="PreviousButton" Content="‹ Previous" Click="PreviousButton_Click" IsEnabled="False" />
                <Button x:Name="NextButton" Content="Next ›" Click="NextButton_Click" IsEnabled="False" Margin="4,0,0,0" />
              </StackPanel>
              <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" Margin="16,0,0,0" Foreground="#275D50" FontWeight="SemiBold" VerticalAlignment="Center" Text="Local EPUB reader" />
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,9,0,0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Mode" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#65726B" />
              <ComboBox x:Name="ReadingModePicker" Width="150" VerticalContentAlignment="Center" SelectedValuePath="Tag" SelectionChanged="ReadingModePicker_SelectionChanged" ToolTip="Choose page-by-page or vertical scrolling">
                <ComboBoxItem Content="Page by page" Tag="page"/><ComboBoxItem Content="Vertical scroll" Tag="scroll"/>
              </ComboBox>
              <Button x:Name="ReaderSettingsButton" Content="Reader settings…" Margin="8,0,8,0" Click="ReaderSettingsButton_Click" />
              <Button x:Name="AddFontButton" Content="Add font…" Click="AddFontButton_Click" Margin="4,0,4,0" />
              <ComboBox x:Name="FontPicker" Width="230" Margin="4,0,8,0" VerticalContentAlignment="Center" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="FontPicker_SelectionChanged" ToolTip="Choose an installed Windows font, an imported local font, or the publisher font" />
              <Button Content="Contents" Click="ContentsButton_Click" Margin="2,0" />
              <Button Content="Search" Click="SearchButton_Click" Margin="2,0" />
              <Button x:Name="BookmarkButton" Content="Bookmark" Click="BookmarkButton_Click" Margin="2,0" />
              <Button Content="Bookmarks…" Click="BookmarksButton_Click" Margin="2,0" />
              <Button Content="Add note/highlight" Click="AddNoteButton_Click" Margin="2,0" />
              <Button Content="Notes…" Click="NotesHubButton_Click" Margin="2,0" />
              <Button x:Name="VocabularyButton" Content="Vocabulary…" Click="VocabularyButton_Click" Margin="2,0" />
              <Button x:Name="FinishBookButton" Content="Mark finished" Click="FinishBookButton_Click" Margin="2,0" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1" Margin="20,18" Background="White" BorderBrush="#E0E4E0" BorderThickness="1" CornerRadius="8">
          <Grid>
            <wv2:WebView2 x:Name="ReaderBrowser" Visibility="Collapsed" />
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
              <TextBlock Text="Your Windows reading space" FontSize="28" FontWeight="SemiBold" Foreground="#20342D" TextAlignment="Center" />
              <TextBlock Margin="0,14,0,0" Text="Import an EPUB or PDF to begin. Your books and reading data stay on this PC; nothing is uploaded." FontSize="15" Foreground="#607068" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#F4F5F3" Padding="18,8,18,10">
      <DockPanel><TextBlock x:Name="StatusText" Foreground="#65726B" FontSize="12" Text="Ready"/><TextBlock DockPanel.Dock="Right" Foreground="#65726B" FontSize="12" Text="Saved locally"/></DockPanel>
    </Border>
    <Border x:Name="DailyReminderToast" Grid.Row="1" Panel.ZIndex="500" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,24,0" Padding="14" MaxWidth="420" Background="#20342D" CornerRadius="10" Visibility="Collapsed">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="Dismiss" Click="DismissReminderToastButton_Click" Margin="12,0,0,0" Padding="8,4" Background="White" Foreground="#20342D" />
        <TextBlock x:Name="DailyReminderToastText" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Grid x:Name="StartupSplash" Grid.RowSpan="3" Panel.ZIndex="1000" Background="#F5F6FF" Visibility="Visible">
      <Grid>
        <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-100,-90,0" Fill="#1F6D5BE8"/>
        <Ellipse Width="240" Height="240" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-70,0,0,-85" Fill="#1FEFA05E"/>
        <StackPanel Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="176" Height="176" CornerRadius="38" Background="White" BorderBrush="#DCE0F0" BorderThickness="1" Padding="19" HorizontalAlignment="Center">
            <Border.Effect><DropShadowEffect Color="#35406E" BlurRadius="24" ShadowDepth="6" Opacity="0.18"/></Border.Effect>
            <Image Source="/WowReader.Windows;component/Assets/wow-logo.png" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="WoW Reader" FontSize="32" FontWeight="Bold" Foreground="#1C1E26" HorizontalAlignment="Center" Margin="0,22,0,0"/>
          <TextBlock Text="Your library · your reading space" FontSize="15" Foreground="#666A78" HorizontalAlignment="Center" Margin="0,7,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,17,0,0">
            <TextBlock Text="✦" FontSize="12" Foreground="#5352D3" VerticalAlignment="Center"/>
            <TextBlock Text="  Whisper Of Words" FontSize="12" Foreground="#7A7E8C" VerticalAlignment="Center"/>
          </StackPanel>
          <ProgressBar IsIndeterminate="True" Width="150" Height="4" Margin="0,32,0,0" Foreground="#5352D3" Background="#DADDF0"/>
          <TextBlock x:Name="StartupSplashStatusText" Text="Opening your reading space…" FontSize="12" Foreground="#777B88" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
