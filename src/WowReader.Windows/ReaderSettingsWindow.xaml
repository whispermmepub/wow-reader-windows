<Window x:Class="WowReader.Windows.ReaderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reader settings" Width="760" Height="700" MinWidth="620" MinHeight="520" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#F4F5F3">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="2,0,2,12">
      <TextBlock Text="Reader settings" FontSize="24" FontWeight="SemiBold" Foreground="#20342D" />
      <TextBlock Margin="0,4,0,0" Text="Saved on this PC. Settings affect EPUB reading only." Foreground="#65726B" />
      <CheckBox x:Name="BookTypographyOverrideCheck" Margin="0,8,0,0" Content="Save typography and spacing for this book only" ToolTip="Only typography and spacing become book-specific; reminders and display options remain global." />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="2,0,8,0">
        <Border Padding="14" Margin="0,0,0,12" Background="White" BorderBrush="#D9DEDA" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <TextBlock Text="Reading flow" FontSize="17" FontWeight="SemiBold" Foreground="#275D50" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Reading mode" VerticalAlignment="Center" />
              <ComboBox x:Name="ReadingModePicker" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="Page by page" Tag="page"/><ComboBoxItem Content="Vertical scroll" Tag="scroll"/>
              </ComboBox>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Page animation" VerticalAlignment="Center" />
              <ComboBox x:Name="PageAnimationPicker" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="None · default" Tag="none"/><ComboBoxItem Content="Smooth slide" Tag="slide"/><ComboBoxItem Content="Page Curl · Android only" Tag="curl" IsEnabled="False"/>
              </ComboBox>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="EPUB formatting" VerticalAlignment="Center" />
              <ComboBox x:Name="FormattingPicker" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="Original EPUB" Tag="original"/><ComboBoxItem Content="Reader settings" Tag="reader"/>
              </ComboBox>
            </Grid>
            <CheckBox x:Name="AutoScrollCheck" Margin="170,10,0,0" Content="Auto scroll (Vertical scroll mode only)" Checked="ControlChanged" Unchecked="ControlChanged" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Auto-scroll speed" VerticalAlignment="Center" />
              <Slider x:Name="AutoScrollSpeedSlider" Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AutoScrollSpeedSlider_ValueChanged" />
              <TextBlock x:Name="AutoScrollSpeedValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Auto-scroll scope" VerticalAlignment="Center" />
              <ComboBox x:Name="AutoScrollScopePicker" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="Whole book" Tag="whole"/><ComboBoxItem Content="This chapter" Tag="chapter"/>
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <Border Padding="14" Margin="0,0,0,12" Background="White" BorderBrush="#D9DEDA" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <TextBlock Text="Typography and spacing" FontSize="17" FontWeight="SemiBold" Foreground="#275D50" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Font size" VerticalAlignment="Center" />
              <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="80" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="FontSizeSlider_ValueChanged" />
              <TextBlock x:Name="FontSizeValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Font weight" VerticalAlignment="Center" />
              <Slider x:Name="FontWeightSlider" Grid.Column="1" Minimum="200" Maximum="800" TickFrequency="100" IsSnapToTickEnabled="True" ValueChanged="FontWeightSlider_ValueChanged" />
              <TextBlock x:Name="FontWeightValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Line spacing" VerticalAlignment="Center" />
              <Slider x:Name="LineHeightSlider" Grid.Column="1" Minimum="120" Maximum="220" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="LineHeightSlider_ValueChanged" />
              <TextBlock x:Name="LineHeightValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Page margins" VerticalAlignment="Center" />
              <Slider x:Name="MarginSlider" Grid.Column="1" Minimum="1" Maximum="14" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="MarginSlider_ValueChanged" />
              <TextBlock x:Name="MarginValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Text alignment" VerticalAlignment="Center" />
              <ComboBox x:Name="AlignmentPicker" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="Original (publisher)" Tag="original"/><ComboBoxItem Content="Justify" Tag="justify"/><ComboBoxItem Content="Left" Tag="left"/><ComboBoxItem Content="Right" Tag="right"/>
              </ComboBox>
            </Grid>
            <CheckBox x:Name="AutoSpacingCheck" Margin="170,10,0,0" Content="Auto Space (smart text justification)" Checked="ControlChanged" Unchecked="ControlChanged" />
            <TextBlock Margin="170,3,0,0" Text="Auto Space affects justified Reader settings; it is not extra paragraph spacing." FontSize="12" Foreground="#65726B" TextWrapping="Wrap" />
            <TextBlock Margin="170,3,0,0" Text="Windows uses installed fonts and fonts you import; Android-only bundled fonts are not included." FontSize="12" Foreground="#65726B" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="14" Margin="0,0,0,12" Background="White" BorderBrush="#D9DEDA" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <TextBlock Text="Appearance and display" FontSize="17" FontWeight="SemiBold" Foreground="#275D50" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Theme" VerticalAlignment="Center" />
              <ComboBox x:Name="ThemePicker" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="ThemePicker_SelectionChanged">
                <ComboBoxItem Content="Day · Light" Tag="light"/><ComboBoxItem Content="Sepia" Tag="sepia"/><ComboBoxItem Content="Night · Dark" Tag="dark"/><ComboBoxItem Content="E-Ink" Tag="eink"/><ComboBoxItem Content="Premium · Soft" Tag="premium"/><ComboBoxItem Content="Custom colors" Tag="custom"/>
              </ComboBox>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Text color override" VerticalAlignment="Center" />
              <TextBox x:Name="CustomTextColorBox" Grid.Column="1" MaxLength="7" TextChanged="ColorBox_TextChanged" ToolTip="Optional #RRGGBB override; leave blank for theme default" />
              <TextBlock Grid.Column="2" Text="#RRGGBB" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#65726B" />
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Background override" VerticalAlignment="Center" />
              <TextBox x:Name="CustomBackgroundColorBox" Grid.Column="1" MaxLength="7" TextChanged="ColorBox_TextChanged" ToolTip="Optional #RRGGBB override; leave blank for theme default" />
              <TextBlock Grid.Column="2" Text="#RRGGBB" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#65726B" />
            </Grid>
            <Border x:Name="AppearancePreviewBorder" Margin="170,10,0,0" Padding="12" Background="#FFFFFF" BorderBrush="#D9DEDA" BorderThickness="1" CornerRadius="7">
              <TextBlock x:Name="AppearancePreviewText" Text="A comfortable page to read · Aa" Foreground="#202124" FontSize="17" FontFamily="Georgia" TextWrapping="Wrap" />
            </Border>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Night Light" VerticalAlignment="Center" />
              <ComboBox x:Name="NightLightPicker" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="Off" Tag="off"/><ComboBoxItem Content="Auto · 7pm–6am" Tag="auto"/><ComboBoxItem Content="On" Tag="on"/>
              </ComboBox>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Reading brightness" VerticalAlignment="Center" />
              <ComboBox x:Name="BrightnessPicker" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="System" Tag="-1"/><ComboBoxItem Content="40%" Tag="40"/><ComboBoxItem Content="60%" Tag="60"/><ComboBoxItem Content="80%" Tag="80"/><ComboBoxItem Content="100%" Tag="100"/>
              </ComboBox>
            </Grid>
            <CheckBox x:Name="KeepScreenOnCheck" Margin="170,10,0,0" Content="Keep the display awake while reading" Checked="ControlChanged" Unchecked="ControlChanged" />
          </StackPanel>
        </Border>

        <Border Padding="14" Margin="0,0,0,12" Background="White" BorderBrush="#D9DEDA" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <TextBlock Text="Reading helpers" FontSize="17" FontWeight="SemiBold" Foreground="#275D50" />
            <CheckBox x:Name="ReadingRulerCheck" Margin="0,10,0,0" Content="Reading ruler" Checked="ControlChanged" Unchecked="ControlChanged" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Ruler height" VerticalAlignment="Center" />
              <Slider x:Name="RulerLinesSlider" Grid.Column="1" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RulerLinesSlider_ValueChanged" />
              <TextBlock x:Name="RulerLinesValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <CheckBox x:Name="EyeBreakReminderCheck" Margin="0,8,0,0" Content="30-minute eye-break reminder" Checked="ControlChanged" Unchecked="ControlChanged" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Position display" VerticalAlignment="Center" />
              <ComboBox x:Name="PositionDisplayPicker" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="Book percentage" Tag="0"/><ComboBoxItem Content="Chapter percentage" Tag="1"/><ComboBoxItem Content="Page / scroll position" Tag="2"/>
              </ComboBox>
            </Grid>
            <TextBlock Margin="0,10,0,0" Text="Screen orientation lock and hardware volume-key navigation are Android-only; use the Windows window controls and keyboard instead." FontSize="12" Foreground="#65726B" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Padding="14" Margin="0,0,0,12" Background="White" BorderBrush="#D9DEDA" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <TextBlock Text="Daily reading reminder" FontSize="17" FontWeight="SemiBold" Foreground="#275D50" />
            <CheckBox x:Name="DailyReminderEnabledCheck" Margin="0,10,0,0" Content="Remind me once each day" Checked="ControlChanged" Unchecked="ControlChanged" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
              <TextBlock Text="Reminder time (24-hour)" VerticalAlignment="Center" />
              <TextBox x:Name="DailyReminderTimeBox" Grid.Column="1" MaxLength="5" Width="90" HorizontalAlignment="Left" Padding="8,5" ToolTip="Use HH:mm, for example 20:30" />
            </Grid>
            <CheckBox x:Name="DailyReminderOnlyIfUnreadCheck" Margin="170,8,0,0" Content="Only remind me if I have not read today" />
            <CheckBox x:Name="DailyReminderStreakNudgeCheck" Margin="170,6,0,0" Content="Mention my current reading streak" />
            <TextBlock Margin="170,6,0,0" Text="This best-effort Windows reminder appears only while WoW Reader is running; it is not a background notification after the app closes." FontSize="12" Foreground="#65726B" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="#D9DEDA" BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="False">
        <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="Reset reader settings" Padding="12,7" Click="ResetButton_Click" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Cancel" MinWidth="82" Margin="0,0,8,0" Padding="12,7" Click="CancelButton_Click" />
          <Button Content="Apply" MinWidth="82" Padding="12,7" IsDefault="True" Click="ApplyButton_Click" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
